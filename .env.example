# Variables de entorno - Página Amelia

# Puerto del servidor backend
PORT=3001

# Directorio de datos (SQLite, JSONs, media)
# Local (desde server/): ../data
# Docker: /app/data
DATA_DIR=/app/data

# Directorio de los estáticos compilados del cliente
# Local (desde server/): ../client/dist
# Docker: /app/client/dist
CLIENT_DIST=/app/client/dist

# Personas de la casa (Nombre:clave separados por coma).
# Si el nombre coincide con una habitación, es su dueño. Todos pueden agregar cosas en cualquier pieza.
USERS="Mariana:mariana,Franco:franco,Amelia:amelia"
